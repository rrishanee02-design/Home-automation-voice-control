{
  "version": 1,
  "author": "wokwi-demo",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -100, "left": 250, "attrs": { "color": "red", "label": "LIGHT1" } },
    { "type": "wokwi-led", "id": "led2", "top": -50, "left": 250, "attrs": { "color": "yellow", "label": "LIGHT2" } },
    { "type": "wokwi-led", "id": "led3", "top": 0, "left": 250, "attrs": { "color": "blue", "label": "FAN" } },
    { "type": "wokwi-led", "id": "led4", "top": 50, "left": 250, "attrs": { "color": "green", "label": "AC" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -100, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -50, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 0, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r4", "top": 50, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-pir-motion-sensor", "id": "pir1", "top": 100, "left": -250, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -100, "left": -250, "attrs": { "temperature": "22" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp:D25", "r1:1", "red", [] ],
    [ "r1:2", "led1:A", "red", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ],

    [ "esp:D26", "r2:1", "gold", [] ],
    [ "r2:2", "led2:A", "gold", [] ],
    [ "led2:C", "esp:GND.1", "black", [] ],

    [ "esp:D14", "r3:1", "blue", [] ],
    [ "r3:2", "led3:A", "blue", [] ],
    [ "led3:C", "esp:GND.1", "black", [] ],

    [ "esp:D33", "r4:1", "green", [] ],
    [ "r4:2", "led4:A", "green", [] ],
    [ "led4:C", "esp:GND.1", "black", [] ],

    [ "pir1:OUT", "esp:D27", "orange", [] ],
    [ "pir1:VCC", "esp:5V", "red", [] ],
    [ "pir1:GND", "esp:GND.2", "black", [] ],

    [ "dht1:SDA", "esp:D4", "gold", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
}
